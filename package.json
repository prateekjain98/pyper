{
  "name": "pyper",
  "version": "0.0.0",
  "private": true,
  "description": "Pyper — privacy-first voice-to-text dictation. Monorepo containing the desktop app and the marketing site.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "desktop": "npm run dev --workspace @pyper/desktop",
    "web": "npm run dev --workspace @pyper/web"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
