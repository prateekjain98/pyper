# The desktop workspace carries dependencies with conflicting/optional peer
# ranges (e.g. better-auth's optional `svelte` peer, and the @tiptap/* set that
# is pinned via the root `overrides`). Relax strict peer enforcement at the
# workspace root so a plain `npm install` resolves the same way the committed
# package-lock.json was generated. This matches Vercel's install command.
legacy-peer-deps=true
