# apps/web env — copy to .env.local for dev, or set in your host (Vercel) for prod.
# NEXT_PUBLIC_* values are PUBLIC (inlined into the client bundle). Everything
# else is server-side only. The demo needs NO secret on the web host when the
# Cloud Run proxy is used — the PyAI key lives only in GCP Secret Manager.

# ── Transcription (Cloud Run proxy — OPTIONAL override) ──────────────────────
# The demo already DEFAULTS to Pyper's Cloud Run proxy (baked into the code), so
# production needs NOTHING set here. The proxy holds the PyAI key (GCP Secret
# Manager) and the browser calls it directly. Set this only to point the demo at
# a different proxy. Public URL — safe to expose.
# NEXT_PUBLIC_TRANSCRIBE_URL=https://pyai-proxy-772208668555.us-central1.run.app/transcribe

# ── Transcription fallback (only if NEXT_PUBLIC_TRANSCRIBE_URL is unset) ──────
# Then /api/transcribe calls PyAI directly and DOES need the key on the host.
# STT_PROVIDER=pyai
# PYAI_API_KEY=pyai_...
# PYAI_BASE_URL=https://api.pyai.com/v1
# PYAI_STT_MODEL=pyai-hear

# ── Cleanup / processing WATERFALL (PyAI is voice-only — never in this chain) ─
# Cleanup is an ordered chain of OpenAI-compatible chat engines. /api/cleanup
# tries each in turn and falls through to the next on any failure (out of
# credits, rate limit, unreachable), so one exhausted key never blocks the demo.
# Unconfigured providers (no base URL / key) are skipped. See lib/engines.ts.
#
# Order (comma-separated), fastest-first. Default when unset: groq,openai,anthropic.
# The formatting pass is on the felt critical path, so the fastest right-sized
# model that clears the quality bar goes first (see docs/wispr-flow-pipeline.md).
# CLEANUP_PROVIDERS=groq,openai,anthropic
#
# Groq LPU (fastest configured, ~300ms; llama-3.3-70b). Has a daily token cap on
# the free tier — the waterfall falls through to OpenAI when it's hit.
# GROQ_API_KEY=gsk_...
# GROQ_CLEANUP_MODEL=llama-3.3-70b-versatile
#
# Cerebras — LOWEST latency (Wispr Flow's speed pick). Opt-in: add it to the FRONT
# of CLEANUP_PROVIDERS and set its key.
# CLEANUP_PROVIDERS=cerebras,groq,openai,anthropic
# CEREBRAS_API_KEY=csk-...
# CEREBRAS_CLEANUP_MODEL=gemma-4-31b   # available models are account-specific
#
# OpenAI (reliable, sub-second fallback).
# OPENAI_API_KEY=sk-...
# OPENAI_CLEANUP_MODEL=gpt-4o-mini
#
# Anthropic (highest-quality backstop, slowest ~1.3s) via its OpenAI-compat endpoint.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CLEANUP_MODEL=claude-haiku-4-5
#
# Legacy single-provider mode still works (honors CLEANUP_MODEL):
# CLEANUP_PROVIDER=groq
# GROQ_API_KEY=gsk_...
#
# Ollama (self-hosted, OpenAI-compatible) is supported but OPT-IN — add it to
# CLEANUP_PROVIDERS and set its base URL to use it:
# CLEANUP_PROVIDERS=ollama,anthropic,openai,groq
# OLLAMA_BASE_URL=https://your-ollama-host/v1
# OLLAMA_API_KEY=          # only if your Ollama is behind a bearer token
# OLLAMA_CLEANUP_MODEL=llama3.1
