# Better Auth (optional - for account features)
# Self-hosted auth server URL (defaults to https://auth.pyper.work)
VITE_AUTH_URL=

# Pyper Cloud API (optional - for cloud transcription)
VITE_PYPER_API_URL=

# Convex sync backend (see convex/README.md). Written by `npx convex dev`.
# VITE_CONVEX_URL is the deployment's function URL (…​.convex.cloud); the sync
# transport targets the sibling …​.convex.site origin for the HTTP-action API.
# Do NOT put CONVEX_DEPLOY_KEY or any secret here — those live in the Convex
# dashboard env, never in the repo.
VITE_CONVEX_URL=

# Dev-only: boot straight into the dashboard as a mock signed-in "Dev User" (no
# auth server needed). Honored ONLY in a Vite dev build (npm run desktop) AND when
# set in a gitignored .env.local. See apps/desktop/src/lib/devMockAuth.ts. Never
# active in packaged builds; cloud features still no-op under it (no real token).
# VITE_DEV_MOCK_USER=true

# Google Calendar integration (optional — for the "Connect Google Calendar"
# button in Settings → Integrations). Without these, the connect flow bounces to
# Google's "invalid_client / OAuth client was not found" page and fails.
#
# Create the client in Google Cloud Console (full steps: docs/google-calendar-oauth-setup.md):
#   1. Enable the "Google Calendar API" for your project.
#   2. Configure the OAuth consent screen; add scope
#      .../auth/calendar.events.readonly (+ calendar.calendarlist.readonly).
#   3. Credentials → Create OAuth client ID → Application type: **Desktop app**
#      (required — the app uses a http://127.0.0.1:<random-port> loopback redirect,
#      which only Desktop-app clients allow; a Web-app client will NOT work).
#   4. Paste the client ID + secret below and restart the app.
# NOTE: this is a SEPARATE client from the Convex Better Auth Google *sign-in*
# client (that one is a Web-app client set via `npx convex env set GOOGLE_CLIENT_ID`).
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret_here

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Customize the Whisper model
# Available models: whisper-1 (default), whisper-1-large, whisper-1-large-v2
WHISPER_MODEL=whisper-1

# Optional: Set language for better transcription accuracy
# Leave empty for auto-detection, or use language codes like 'en', 'es', 'fr', etc.
LANGUAGE=

# Optional: UI language for app interface and menus (en, es, fr, de, pt, it)
UI_LANGUAGE=en

# Anthropic API Configuration (optional - for Claude AI processing)
# Get your API key from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration (optional - for Gemini AI processing)
# Get your API key from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (optional - for ultra-fast cloud inference)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tinfoil API Configuration (optional - for private cloud LLM inference)
# Get your API key from: https://tinfoil.sh/inference
TINFOIL_API_KEY=your_tinfoil_api_key_here

# Mistral API Configuration (optional - for Voxtral transcription)
# Get your API key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Debug mode
PYPER_LOG_LEVEL=debug
