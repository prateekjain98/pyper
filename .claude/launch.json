{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "desktop-renderer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:renderer",
        "-w",
        "@pyper/desktop",
        "--",
        "--port",
        "5199"
      ],
      "port": 5199
    },
    {
      "name": "convex-auth",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:renderer",
        "-w",
        "@pyper/desktop",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "convextest",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "apps/desktop/convextest"
      ],
      "port": 5174
    }
  ]
}
